# Copy this file to .env (frontend/backend each need their own copy, or a
# single root .env if your tooling loads from the root) and fill in real
# values. Never commit the actual .env file.

# Supabase project URL.
# Where to get it: Supabase Dashboard > Project Settings > API > Project URL
SUPABASE_URL=

# Supabase anonymous/public API key — safe to use in frontend code, since
# Row-Level Security policies on every table restrict what it can read/write.
# Where to get it: Supabase Dashboard > Project Settings > API > Project API keys > anon/public
SUPABASE_ANON_KEY=

# Supabase service role key — SERVER-SIDE ONLY. This key bypasses Row-Level
# Security entirely, so it must only ever be used in backend code (never
# shipped to the frontend, never committed). The backend needs it to perform
# privileged writes during ingestion (e.g. inserting embeddings/derived data)
# without being blocked by RLS policies scoped to the requesting user.
# Where to get it: Supabase Dashboard > Project Settings > API > Project API keys > service_role
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key — used server-side (backend only) for categorization,
# summarization, RAG answer generation, and embeddings (gemini-embedding-001).
# Where to get it: Google AI Studio > https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Port the backend Express server listens on. Optional, defaults to 3001.
PORT=3001

# UUID of the single v0 user. There's no login flow yet, so the backend
# writes every saved item under this fixed user_id.
# Where to get it: Supabase Dashboard > Authentication > Users > Add user,
# then copy that user's UUID here. (This will be replaced once real

# URL the frontend uses to reach the backend server. Must be prefixed with
# VITE_ to be exposed to browser code by Vite. Defaults to localhost:3001
# for local dev; change this after deploying the backend elsewhere.
VITE_API_URL=http://localhost:3001
