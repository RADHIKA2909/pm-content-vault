# Supabase — the browser only ever gets the ANON key.
# Project Settings > API > Project URL and "anon public".
#
# The service-role key must NEVER appear in this file. Anything prefixed
# VITE_ is compiled into the JavaScript bundle and readable by anyone who
# opens the page.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the backend is running. Leave unset: locally it defaults to
# http://localhost:3001, and in the Vercel build the API is served from the
# same origin under /api, so no base URL is needed.
VITE_API_URL=
