# Supabase
SUPABASE_URL=
# Service role — bypasses row-level security. Server-side only, never in the
# frontend and never committed.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (generation + embeddings)
GEMINI_API_KEY=

PORT=3001

# Comma-separated browser origins allowed to call this API. Only needed when
# the frontend is served from a different origin — in the Vercel deployment
# they share one domain, so nothing is cross-origin and this can stay unset.
CORS_ORIGINS=
